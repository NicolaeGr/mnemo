package layouts

import (
	"github.com/nicolaegr/mnemo/internal/web/domain"
	"github.com/nicolaegr/mnemo/internal/web/seg"
	"github.com/nicolaegr/mnemo/internal/web/uictx"
)

templ DashboardSegment(child templ.Component) {
	<div class="min-h-dvh bg-background text-foreground">
		<div class="flex min-h-dvh">
			<aside class="w-60 shrink-0 border-r border-border bg-background flex flex-col">
				<div class="flex h-14 items-center gap-2 border-b border-border px-4">
					<span
						class="grid h-7 w-7 place-items-center rounded-lg bg-accent text-accent-foreground text-sm font-semibold"
					>M</span>
					<span class="font-semibold tracking-tight">mnemo</span>
				</div>
				<nav class="flex-1 space-y-1 p-3 text-sm">
					@NavLink("/dashboard", "Overview")
					@NavLink("/dashboard/books", "Books")
					@NavLink("/dashboard/devices", "Devices")
					@NavLink("/dashboard/contacts", "Contacts")
					@NavLink("/dashboard/settings", "Settings")
				</nav>
				<div class="border-t border-border p-3">
					<button
						type="button"
						popovertarget="user-menu"
						class="popover-user-trigger flex w-full items-center gap-2 rounded-md px-2 py-2 text-sm hover:bg-muted transition-colors"
					>
						<span class="grid h-8 w-8 place-items-center rounded-full bg-muted text-xs font-medium">
							{ initials(seg.Data(ctx, "dashboard")) }
						</span>
						<span class="flex min-w-0 flex-1 flex-col items-start">
							<span class="truncate font-medium">{ userName(seg.Data(ctx, "dashboard")) }</span>
							<span class="truncate text-xs text-muted-foreground">{ userEmail(seg.Data(ctx, "dashboard")) }</span>
						</span>
						<span class="text-muted-foreground text-xs">
							<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
						</span>
					</button>
					<div id="user-menu" popover class="w-64 rounded-lg p-1 text-sm">
						<div class="px-3 py-2">
							<p class="font-medium">{ userName(seg.Data(ctx, "dashboard")) }</p>
							<p class="truncate text-xs text-muted-foreground">{ userEmail(seg.Data(ctx, "dashboard")) }</p>
						</div>
						<div class="my-1 border-t border-border"></div>
						<a
							href="/dashboard/settings"
							hx-get="/dashboard/settings"
							hx-push-url="true"
							class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left hover:bg-muted transition-colors"
						>Settings</a>
						<button
							type="button"
							onclick="toggleTheme()"
							class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left hover:bg-muted transition-colors"
						>
							<span>Toggle theme</span>
							<span class="ml-auto text-muted-foreground" data-theme-icon>
								<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
							</span>
						</button>
						<div class="my-1 border-t border-border"></div>
						<form action="/logout" method="post" hx-post="/logout" hx-swap="none">
							<input type="hidden" name="csrf" value={ uictx.From(ctx).CSRF }/>
							<button
								type="submit"
								class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-muted-foreground hover:bg-muted hover:text-foreground transition-colors"
							>Log out</button>
						</form>
					</div>
				</div>
			</aside>
			<div class="flex min-w-0 flex-1 flex-col">
				<header
					class="sticky top-0 z-40 flex h-14 items-center justify-between border-b border-border bg-background/80 px-6 backdrop-blur"
				>
					<div class="text-sm font-medium text-muted-foreground">Workspace</div>
					<button
						type="button"
						onclick="toggleTheme()"
						class="grid h-8 w-8 place-items-center rounded-md border border-border text-muted-foreground hover:bg-muted transition-colors"
						title="Toggle theme"
					>
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
					</button>
				</header>
				<main id="outlet-dashboard" class="flex-1 p-6 md:p-8">
					@child
				</main>
			</div>
		</div>
	</div>
}

templ NavLink(href, label string) {
	<a
		href={ href }
		hx-get={ href }
		hx-push-url="true"
		class={ "flex items-center gap-2 rounded-md px-3 py-2 transition-colors", navClass(seg.Path(ctx), href) }
	>{ label }</a>
}

func navClass(current, href string) string {
	if current == href {
		return "bg-muted text-foreground"
	}
	return "text-muted-foreground hover:bg-muted hover:text-foreground"
}

func userName(u any) string {
	if usr, ok := u.(*domain.User); ok && usr != nil {
		return usr.Name
	}
	return "Guest"
}

func userEmail(u any) string {
	if usr, ok := u.(*domain.User); ok && usr != nil {
		return usr.Email
	}
	return ""
}

func initials(u any) string {
	if usr, ok := u.(*domain.User); ok && usr != nil && len(usr.Name) > 0 {
		return string([]rune(usr.Name)[0])
	}
	return "?"
}
