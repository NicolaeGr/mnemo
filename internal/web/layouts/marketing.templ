package layouts

templ MarketingSegment(child templ.Component) {
	<div class="min-h-dvh flex flex-col">
		<header class="border-b border-border bg-background/80 backdrop-blur sticky top-0 z-40">
			<nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
				<a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
					<span class="grid h-6 w-6 place-items-center rounded-md bg-accent text-accent-foreground text-xs">S</span>
					Segment
				</a>
				<div class="flex items-center gap-1 text-sm">
					<a href="/" class="px-3 py-1.5 rounded-md text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">Home</a>
					<a href="/about" class="px-3 py-1.5 rounded-md text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">About</a>
					<a href="/login" class="px-3 py-1.5 rounded-md bg-accent text-accent-foreground hover:opacity-90 transition-opacity">Sign in</a>
				</div>
			</nav>
		</header>
		<main id="outlet-marketing" class="flex-1">
			@child
		</main>
		<footer class="border-t border-border py-6">
			<p class="mx-auto max-w-6xl px-4 text-sm text-muted-foreground">© 2026</p>
		</footer>
	</div>
}
