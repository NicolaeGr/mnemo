package layouts

// Modal is the shell every add/edit form opens in: it drops content into
// #modal-root and every close affordance (backdrop, X, Escape) asks the server
// for an empty body, which clears that container.
templ Modal(title string, child templ.Component) {
	<div class="fixed inset-0 z-50 grid place-items-center p-4">
		<div
			class="absolute inset-0 bg-black/40 backdrop-blur-sm"
			hx-get="/dashboard/modal/close"
			hx-target="#modal-root"
			hx-swap="innerHTML"
			aria-hidden="true"
		></div>
		<div class="relative w-full max-w-lg overflow-hidden rounded-xl border border-border bg-background shadow-xl">
			<div class="flex items-center justify-between border-b border-border px-4 py-3">
				<span id="modal-title" class="text-sm font-medium">{ title }</span>
				<button
					type="button"
					title="Close"
					class="grid h-7 w-7 place-items-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground transition-colors"
					hx-get="/dashboard/modal/close"
					hx-target="#modal-root"
					hx-swap="innerHTML"
				>
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
				</button>
			</div>
			<div class="max-h-[75vh] overflow-y-auto p-4">
				@child
			</div>
		</div>
		<div
			class="hidden"
			hx-get="/dashboard/modal/close"
			hx-target="#modal-root"
			hx-swap="innerHTML"
			hx-trigger="keyup[key=='Escape'] from:body"
		></div>
	</div>
}
