package pages

import (
	"encoding/json"
	"strconv"

	"github.com/nicolaegr/mnemo/internal/store"
	"github.com/nicolaegr/mnemo/internal/web/uictx"
)

// defaultTiers matches the books.synced_tiers column default, so a new book
// starts where the schema would put it.
var defaultTiers = []string{"primary", "secondary"}

var allTiers = []string{"primary", "secondary", "archived"}

// ListsData carries the lists page and its sortable grid fragment.
type ListsData struct {
	Summaries []store.BookSummary
	Sort      string
	ErrMsg    string
}

func listsSortData(sort string) string {
	if sort == "" {
		sort = "name"
	}
	data, _ := json.Marshal(map[string]any{
		"sort":     sort,
		"endpoint": "/dashboard/books/grid",
		"target":   "#books-list",
	})
	return string(data)
}

templ ListsPage(d ListsData) {
	<div class="space-y-6">
		@PageHeader("Lists", countLabel(len(d.Summaries), "list"), newList())
		<div x-data={ "listSort(" + listsSortData(d.Sort) + ")" } class="flex flex-wrap items-center gap-2 text-sm">
			<span class="text-muted-foreground">Sort by</span>
			<button type="button" @click="setSort('name')" :class="sort === 'name' ? activeClass : idleClass">Name</button>
			<button type="button" @click="setSort('contacts')" :class="sort === 'contacts' ? activeClass : idleClass">Contact count</button>
		</div>
		@ListGrid(d)
	</div>
}

// ListGrid is the card grid, rendered both into the page and as the materialised
// response for a sort change (its own id is the htmx target).
templ ListGrid(d ListsData) {
	<div id="books-list" class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
		if d.ErrMsg != "" {
			<div class="md:col-span-2 xl:col-span-3">
				@ErrorBanner(d.ErrMsg)
			</div>
		}
		if len(d.Summaries) == 0 {
			<div class="md:col-span-2 xl:col-span-3">
				@EmptyState("No lists yet", "Create a list to group contacts and sync them to chosen devices.", newList())
			</div>
		} else {
			for _, s := range d.Summaries {
				@ListCard(s)
			}
		}
	</div>
}

templ ListCard(s store.BookSummary) {
	<div class="flex flex-col rounded-lg border border-border bg-background">
		<div class="flex items-start justify-between gap-3 p-4">
			<div class="min-w-0">
				<div class="flex flex-wrap items-center gap-2">
					<span class="truncate font-medium">{ s.Book.DisplayName }</span>
					if !s.Book.IsActive {
						@Badge("inactive", "danger")
					}
				</div>
				<div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
					<span class="font-mono">{ s.Book.Slug }</span>
					<span>·</span>
					<span>{ countLabel(s.ContactCount, "contact") }</span>
				</div>
				<div class="mt-2 flex flex-wrap gap-1">
					for _, t := range s.Book.SyncedTiers {
						@Chip(t)
					}
				</div>
			</div>
			<button
				type="button"
				class="grid h-8 w-8 shrink-0 place-items-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
				title="Edit list"
				hx-get={ "/dashboard/books/" + strconv.FormatInt(s.Book.ID, 10) + "/edit" }
				hx-target="#modal-root"
				hx-swap="innerHTML"
			>
				@Icon("edit")
			</button>
		</div>
		<div class="border-t border-border">
			if len(s.Preview) == 0 {
				<p class="px-4 py-6 text-center text-xs text-muted-foreground">No contacts in this list.</p>
			} else {
				<div class="divide-y divide-border">
					for _, p := range s.Preview {
						@PreviewRow(p)
					}
				</div>
			}
		</div>
		if s.ContactCount > 0 {
			<div class="mt-auto border-t border-border">
				<a
					href={ listContactsURL(s.Book.ID) }
					hx-get={ listContactsURL(s.Book.ID) }
					hx-push-url="true"
					class="flex items-center justify-between gap-3 px-4 py-2 text-sm text-muted-foreground transition-colors hover:bg-muted/40 hover:text-foreground"
				>
					<span>{ listFooterLabel(s) }</span>
					@Icon("arrow-right")
				</a>
			</div>
		}
	</div>
}

templ PreviewRow(p store.ContactPreview) {
	<div class="flex items-center justify-between gap-3 px-4 py-2 text-sm">
		<span class="truncate">{ p.Name }</span>
		<span class="shrink-0 text-xs text-muted-foreground">{ previewSecondary(p) }</span>
	</div>
}

func previewSecondary(p store.ContactPreview) string {
	if p.Tel != "" {
		return p.Tel
	}
	return p.Email
}

func listContactsURL(bookID int64) string {
	return "/dashboard/contacts?book=" + strconv.FormatInt(bookID, 10)
}

// listFooterLabel names the card's footer action: how many more contacts the
// list holds beyond the preview, or a plain "view all" when it holds none back.
func listFooterLabel(s store.BookSummary) string {
	if remaining := s.ContactCount - len(s.Preview); remaining > 0 {
		return "View " + strconv.Itoa(remaining) + " more"
	}
	return "View all contacts"
}

templ newList() {
	<button
		type="button"
		class="inline-flex h-9 items-center gap-1.5 rounded-md bg-accent px-3 text-sm text-accent-foreground transition-opacity hover:opacity-90"
		hx-get="/dashboard/books/new"
		hx-target="#modal-root"
		hx-swap="innerHTML"
	>
		@Icon("plus")
		<span>New list</span>
	</button>
}

// BookForm renders the add (b == nil) or edit form inside a modal. Submitting
// refreshes #books-list and the response clears the modal.
templ BookForm(b *store.Book) {
	<form hx-post={ bookFormAction(b) } hx-target="#books-list" hx-swap="outerHTML" class="space-y-4">
		<input type="hidden" name="csrf" value={ uictx.From(ctx).CSRF }/>
		if b == nil {
			@BookIdentity("")
		} else {
			@TextField("Name", "display_name", b.DisplayName, "Work", true)
			<div>
				<label class="mb-1 block text-xs font-medium text-muted-foreground" for="slug">Slug</label>
				<input
					id="slug"
					type="text"
					value={ b.Slug }
					disabled
					class="h-9 w-full rounded-md border border-input bg-muted px-3 text-sm text-muted-foreground"
				/>
			</div>
		}
		@TextField("Description", "description", bookDescription(b), "", false)
		<fieldset>
			<legend class="mb-1 text-xs font-medium text-muted-foreground">Synced tiers</legend>
			<div class="flex flex-wrap gap-4">
				for _, tier := range allTiers {
					@CheckRow("tiers", tier, tier, hasTier(bookTiers(b), tier))
				}
			</div>
			<p class="mt-1 text-xs text-muted-foreground">Pick at least one; archived can't be combined with primary or secondary.</p>
		</fieldset>
		if b != nil {
			<input type="hidden" name="active" value="false"/>
			@CheckRow("active", "true", "Active", b.IsActive)
		}
		<div class="flex items-center justify-between gap-2 pt-2">
			<div>
				if b != nil {
					<button
						type="button"
						class="inline-flex h-9 items-center rounded-md border border-red-600/40 px-3 text-sm text-red-600 transition-colors hover:bg-red-600/10"
						hx-post={ "/dashboard/books/" + strconv.FormatInt(b.ID, 10) + "/delete" }
						hx-target="#books-list"
						hx-swap="outerHTML"
						hx-confirm="Delete this book? Its contacts stay and become untagged if it was their only list."
					>Delete</button>
				}
			</div>
			@PrimaryButton("Save")
		</div>
	</form>
}

// BookIdentity is the add form's name + slug pair: the slug follows the name
// until it is edited by hand, and a taken auto slug gets digits appended.
templ BookIdentity(name string) {
	<div x-data={ "slugField(" + slugData(name) + ")" } class="space-y-4">
		<div>
			<label class="mb-1 block text-xs font-medium text-muted-foreground" for="display_name">Name</label>
			<input
				id="display_name"
				name="display_name"
				x-model="name"
				@input.debounce.300ms="onName()"
				placeholder="Work"
				required
				class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm outline-none focus:border-transparent focus:ring-2 focus:ring-ring"
			/>
		</div>
		<div>
			<label class="mb-1 block text-xs font-medium text-muted-foreground" for="slug">Slug</label>
			<input
				id="slug"
				name="slug"
				x-model="slug"
				@input.debounce.300ms="check()"
				placeholder="work"
				required
				class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm outline-none focus:border-transparent focus:ring-2 focus:ring-ring"
			/>
			<p class="mt-1 h-4 text-xs">
				<span x-show="status === 'taken'" x-cloak class="text-red-600">already used</span>
				<span x-show="status === 'checking'" x-cloak class="text-muted-foreground">checking…</span>
			</p>
		</div>
	</div>
}

func slugData(name string) string {
	data, _ := json.Marshal(map[string]any{
		"endpoint": "/dashboard/books/slug",
		"name":     name,
		"slug":     "",
	})
	return string(data)
}

func bookFormAction(b *store.Book) string {
	if b == nil {
		return "/dashboard/books"
	}
	return "/dashboard/books/" + strconv.FormatInt(b.ID, 10) + "/edit"
}

func bookDescription(b *store.Book) string {
	if b == nil || b.Description == nil {
		return ""
	}
	return *b.Description
}

func bookTiers(b *store.Book) []string {
	if b == nil {
		return defaultTiers
	}
	return b.SyncedTiers
}

func hasTier(tiers []string, want string) bool {
	for _, t := range tiers {
		if t == want {
			return true
		}
	}
	return false
}
