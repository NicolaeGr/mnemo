package pages

import (
	"encoding/json"
	"strconv"
	"strings"
	"time"

	"github.com/nicolaegr/mnemo/internal/contact"
	"github.com/nicolaegr/mnemo/internal/store"
	"github.com/nicolaegr/mnemo/internal/web/uictx"
)

// ContactView is one contact plus the books it is tagged into (the list row).
type ContactView struct {
	Contact store.Contact
	Name    string
	Tel     string
	Email   string
	Org     string
	Books   map[int64]bool
}

// ContactFormData seeds the contact editor.
type ContactFormData struct {
	ID         int64
	UID        string
	Filename   string
	TitleBase  string
	FullName   string
	Prefix     string
	Given      string
	Additional string
	Family     string
	Suffix     string
	Fields     []contact.Field
	Addresses  []contact.Address
	Books      []store.Book // selectable books (active)
	Selected   []int64      // current tags
	Action     string
}

func bookOptions(books []store.Book) []MultiOption {
	out := make([]MultiOption, 0, len(books))
	for _, b := range books {
		out = append(out, MultiOption{Value: b.ID, Label: b.DisplayName})
	}
	return out
}

func contactEditorData(d ContactFormData) string {
	fields := d.Fields
	if fields == nil {
		fields = []contact.Field{}
	}
	addresses := d.Addresses
	if addresses == nil {
		addresses = []contact.Address{}
	}
	data, _ := json.Marshal(map[string]any{
		"fields":       fields,
		"addresses":    addresses,
		"titleBase":    d.TitleBase,
		"prefix":       d.Prefix,
		"given":        d.Given,
		"additional":   d.Additional,
		"family":       d.Family,
		"suffix":       d.Suffix,
		"kinds":        contact.Kinds(),
		"nameParts":    contact.NameParts(),
		"addressParts": contact.AddressParts(),
	})
	return string(data)
}

// ContactsData is everything the contacts page and its rows fragment need.
type ContactsData struct {
	Contacts     []ContactView
	Books        []store.Book
	Q            string
	Sort         string
	Dir          string
	SortExplicit bool
	Page         int
	Per          int
	Total        int
	BookID       string
	BookName     string
	ErrMsg       string
}

func contactsViewData(d ContactsData) string {
	// With no chosen column the server ranks by relevance, so no header should
	// read as the active sort. An explicit sort is echoed to the controller.
	sort := d.Sort
	if !d.SortExplicit {
		sort = ""
	}
	data, _ := json.Marshal(map[string]any{
		"q":        d.Q,
		"sort":     sort,
		"dir":      d.Dir,
		"page":     d.Page,
		"per":      d.Per,
		"total":    d.Total,
		"book":     d.BookID,
		"ids":      ContactIDs(d),
		"specs":    store.ContactSearchFields(),
		"endpoint": "/dashboard/contacts/search",
		"target":   "#contacts-rows",
	})
	return string(data)
}

templ ContactsPage(d ContactsData) {
	<div class="space-y-6">
		@PageHeader("Contacts", countLabel(d.Total, "contact"), addContact())
		@ContactsList(d)
	</div>
}

// ContactsList is the swap target for contact mutations (the edit form points
// here), separate from the page chrome above it.
templ ContactsList(d ContactsData) {
	<div id="contacts-list">
		@ContactTable(d)
	</div>
}

// ContactTable is the Alpine-driven list region. The search box and table head
// stay mounted while the controller swaps only #contacts-rows.
templ ContactTable(d ContactsData) {
	<div x-data={ "listView(" + contactsViewData(d) + ")" } @listmeta.window="onMeta($event)" class="space-y-4">
		<div class="flex flex-wrap items-center gap-3">
			<div class="relative min-w-[16rem] max-w-md flex-1" @click.outside="closeCombo()">
				<span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">
					@Icon("search")
				</span>
				<input
					x-ref="search"
					type="search"
					x-model="q"
					@input="onSearchInput()"
					@keydown="onSearchKeydown($event)"
					placeholder="Search — try name:Josh, org:Acme, has:phone"
					autocomplete="off"
					role="combobox"
					aria-autocomplete="list"
					:aria-expanded="comboOpen ? 'true' : 'false'"
					class="h-9 w-full rounded-md border border-input bg-background pl-9 pr-9 text-sm outline-none focus:border-transparent focus:ring-2 focus:ring-ring"
				/>
				<span x-show="loading" x-cloak class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground">
					@Icon("spinner")
				</span>
				<button
					type="button"
					x-show="q.length > 0 && !loading"
					x-cloak
					aria-label="Clear search"
					title="Clear search"
					@click="clearQuery()"
					class="absolute right-2 top-1/2 inline-flex h-6 w-6 -translate-y-1/2 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
				>
					@Icon("x")
				</button>
				<div
					x-show="comboOpen"
					x-cloak
					role="listbox"
					class="absolute left-0 right-0 top-full z-30 mt-1 w-full overflow-hidden rounded-md border border-border bg-background p-1 shadow-lg"
				>
					<template x-for="(s, i) in comboItems" :key="s.key">
						<button
							type="button"
							role="option"
							tabindex="-1"
							:aria-selected="i === comboIndex"
							@mousedown.prevent="pickSuggestion(s)"
							@mouseenter="comboIndex = i"
							:class="i === comboIndex ? 'bg-accent/15 text-accent' : ''"
							class="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left text-xs transition-colors"
						>
							<span class="text-[10px] font-medium uppercase tracking-wide">Match</span>
							<span class="truncate" x-text="s.label"></span>
						</button>
					</template>
				</div>
			</div>
			if d.BookName != "" {
				<a href="/dashboard/contacts" class="inline-flex items-center gap-1 rounded-full bg-muted px-3 py-1 text-xs transition-colors hover:bg-border" title="Clear list filter">
					in { d.BookName }
					<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
				</a>
			}
			<span class="ml-auto text-sm text-muted-foreground"><span x-text="countLabel"></span></span>
		</div>
		<div class="flex flex-wrap items-center gap-2">
			<button type="button" @click="toggleToken('has:phone')" class="inline-flex items-center rounded border px-1.5 py-0.5 text-xs transition-colors" :class="hasToken('has:phone') ? 'border-transparent bg-accent text-accent-foreground' : 'border-border text-muted-foreground hover:bg-muted'">Has phone</button>
			<button type="button" @click="toggleToken('has:email')" class="inline-flex items-center rounded border px-1.5 py-0.5 text-xs transition-colors" :class="hasToken('has:email') ? 'border-transparent bg-accent text-accent-foreground' : 'border-border text-muted-foreground hover:bg-muted'">Has email</button>
			<button type="button" @click="toggleToken('untagged:1')" class="inline-flex items-center rounded border px-1.5 py-0.5 text-xs transition-colors" :class="hasToken('untagged:1') ? 'border-transparent bg-accent text-accent-foreground' : 'border-border text-muted-foreground hover:bg-muted'">Untagged</button>
		</div>
		<div x-show="hasSelection" x-cloak class="flex flex-wrap items-center gap-2 rounded-lg border border-border bg-muted/40 px-3 py-2 text-sm">
			<span><span x-text="selected.length"></span> selected</span>
			<button
				type="button"
				class="inline-flex h-8 items-center gap-1.5 rounded-md border border-red-600/40 px-3 text-xs text-red-600 transition-colors hover:bg-red-600/10"
				hx-post="/dashboard/contacts/bulk"
				hx-vals={ bulkVals("delete", uictx.From(ctx).CSRF) }
				hx-include=".contact-row-check"
				hx-target="#contacts-list"
				hx-swap="outerHTML"
				hx-confirm="Delete the selected contacts? They are soft-deleted and purged after two days."
			>
				@Icon("trash")
				<span>Delete</span>
			</button>
			<button
				type="button"
				class="inline-flex h-8 items-center gap-1.5 rounded-md border border-border px-3 text-xs transition-colors hover:bg-muted"
				hx-get="/dashboard/contacts/bulk-modal?mode=add"
				hx-include=".contact-row-check"
				hx-target="#modal-root"
				hx-swap="innerHTML"
			>
				@Icon("plus")
				<span>Add to lists</span>
			</button>
			<button
				type="button"
				class="inline-flex h-8 items-center gap-1.5 rounded-md border border-border px-3 text-xs transition-colors hover:bg-muted"
				hx-get="/dashboard/contacts/bulk-modal?mode=set"
				hx-include=".contact-row-check"
				hx-target="#modal-root"
				hx-swap="innerHTML"
			>
				@Icon("lists")
				<span>Set lists</span>
			</button>
			<button type="button" @click="clearSelection()" class="ml-auto text-xs text-muted-foreground transition-colors hover:text-foreground">Clear</button>
		</div>
		<div class="overflow-hidden rounded-lg border border-border">
			<table class="w-full text-sm">
				<thead class="border-b border-border bg-muted/40">
					<tr>
						<th scope="col" class="w-px px-3 py-2">
							<input type="checkbox" aria-label="Select all contacts" class="h-4 w-4" style="accent-color: var(--accent)" :checked="allSelected" @change="toggleAll()"/>
						</th>
						<th scope="col" class="w-px px-3 py-2"><span class="sr-only">Actions</span></th>
						@SortableTh("name", "Name", "")
						<th scope="col" class="hidden px-3 py-2 text-left text-xs font-medium text-muted-foreground sm:table-cell">Phone</th>
						<th scope="col" class="hidden px-3 py-2 text-left text-xs font-medium text-muted-foreground xl:table-cell">Lists</th>
						@SortableTh("org", "Organization", "hidden lg:table-cell")
						<th scope="col" class="hidden px-3 py-2 text-left text-xs font-medium text-muted-foreground sm:table-cell">Email</th>
						@SortableTh("updated", "Updated", "hidden lg:table-cell")
					</tr>
				</thead>
				<tbody id="contacts-rows" class="divide-y divide-border">
					@ContactRows(d)
				</tbody>
			</table>
		</div>
		<div class="flex items-center justify-between gap-2">
			<p class="text-xs text-muted-foreground">Page <span x-text="page"></span> of <span x-text="pages"></span></p>
			<div class="flex gap-2" x-show="pages > 1">
				<button type="button" @click="go(page - 1)" :disabled="!hasPrev" class="inline-flex h-8 items-center rounded-md border border-border px-3 text-xs transition-colors hover:bg-muted disabled:cursor-not-allowed disabled:opacity-40">Previous</button>
				<button type="button" @click="go(page + 1)" :disabled="!hasNext" class="inline-flex h-8 items-center rounded-md border border-border px-3 text-xs transition-colors hover:bg-muted disabled:cursor-not-allowed disabled:opacity-40">Next</button>
			</div>
		</div>
	</div>
}

// ContactRows is the tbody content, rendered both into the full page and as the
// htmx response that replaces #contacts-rows.
templ ContactRows(d ContactsData) {
	if d.ErrMsg != "" {
		<tr>
			<td colspan="8" class="px-3 py-4">
				@ErrorBanner(d.ErrMsg)
			</td>
		</tr>
	} else if len(d.Contacts) == 0 {
		<tr>
			<td colspan="8">
				@contactsEmpty(d)
			</td>
		</tr>
	} else {
		for _, c := range d.Contacts {
			@ContactRow(c, d.Books)
		}
	}
}

templ ContactRow(c ContactView, books []store.Book) {
	<tr class="hover:bg-muted/40">
		<td class="w-px px-3 py-2">
			<input
				type="checkbox"
				name="id"
				value={ strconv.FormatInt(c.Contact.ID, 10) }
				class="contact-row-check h-4 w-4"
				style="accent-color: var(--accent)"
				aria-label="Select contact"
				:checked={ "selected.includes(" + strconv.FormatInt(c.Contact.ID, 10) + ")" }
				@change={ "toggle(" + strconv.FormatInt(c.Contact.ID, 10) + ")" }
			/>
		</td>
		<td class="w-px px-3 py-2">
			<div class="relative" x-data="rowMenu()" @click.outside="close()">
				<button
					type="button"
					class="grid h-8 w-8 place-items-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
					title="Actions"
					@click="toggle($event)"
				>
					@Icon("more")
				</button>
				<div
					x-show="open"
					x-cloak
					:style="panelStyle"
					class="fixed z-50 w-44 overflow-hidden rounded-lg border border-border bg-popover p-1 text-sm text-popover-foreground shadow-xl"
				>
					<button type="button" class="menu-item" @click="close()" hx-get={ "/dashboard/contacts/" + strconv.FormatInt(c.Contact.ID, 10) + "/view" } hx-target="#modal-root" hx-swap="innerHTML">View</button>
					<button type="button" class="menu-item" @click="close()" hx-get={ "/dashboard/contacts/" + strconv.FormatInt(c.Contact.ID, 10) + "/edit" } hx-target="#modal-root" hx-swap="innerHTML">Edit</button>
					<button type="button" class="menu-item text-red-600 hover:bg-red-600/10" @click="close()" hx-post={ "/dashboard/contacts/" + strconv.FormatInt(c.Contact.ID, 10) + "/delete" } hx-target="#contacts-list" hx-swap="outerHTML" hx-confirm="Delete this contact? It is soft-deleted and purged after two days.">Delete</button>
					<div class="my-1 border-t border-border"></div>
					<div class="flex items-center justify-between gap-2 px-2 py-1.5 text-xs text-muted-foreground/60">
						<span class="flex items-center gap-2">
							@Icon("shared")
							<span>Share</span>
						</span>
						@Badge("Soon", "muted")
					</div>
					<div class="flex items-center justify-between gap-2 px-2 py-1.5 text-xs text-muted-foreground/60">
						<span class="flex items-center gap-2">
							@Icon("overview")
							<span>Details</span>
						</span>
						@Badge("Soon", "muted")
					</div>
				</div>
			</div>
		</td>
		<td class="px-3 py-2">
			<button
				type="button"
				class="text-left font-medium hover:underline"
				hx-get={ "/dashboard/contacts/" + strconv.FormatInt(c.Contact.ID, 10) + "/view" }
				hx-target="#modal-root"
				hx-swap="innerHTML"
			>{ c.Name }</button>
		</td>
		<td class="hidden px-3 py-2 text-muted-foreground sm:table-cell">{ c.Tel }</td>
		<td class="hidden px-3 py-2 xl:table-cell">
			<div class="flex flex-wrap gap-1">
				for _, b := range books {
					if c.Books[b.ID] {
						@Chip(b.DisplayName)
					}
				}
			</div>
		</td>
		<td class="hidden px-3 py-2 text-muted-foreground lg:table-cell">{ c.Org }</td>
		<td class="hidden px-3 py-2 text-muted-foreground sm:table-cell">{ c.Email }</td>
		<td class="hidden px-3 py-2 text-xs text-muted-foreground lg:table-cell">{ relativeTime(&c.Contact.UpdatedAt) }</td>
	</tr>
}

templ contactsEmpty(d ContactsData) {
	if d.Q != "" {
		@EmptyState("No matches", "Nothing matched \u201c"+d.Q+"\u201d in your contacts.", clearSearchLink())
	} else {
		@EmptyState("No contacts yet", "Add your first contact to get started.", addContact())
	}
}

templ clearSearchLink() {
	<a href="/dashboard/contacts" class="inline-flex h-9 items-center rounded-md border border-border px-3 text-sm transition-colors hover:bg-muted">Clear search</a>
}

templ addContact() {
	<button
		type="button"
		class="inline-flex h-9 items-center gap-1.5 rounded-md bg-accent px-3 text-sm text-accent-foreground transition-opacity hover:opacity-90"
		hx-get="/dashboard/contacts/new"
		hx-target="#modal-root"
		hx-swap="innerHTML"
	>
		@Icon("plus")
		<span>Add contact</span>
	</button>
}

// ContactDetail is the read-only view of one contact: a structured name, the
// grouped property fields, addresses, list membership, and audit stamps.
type ContactDetail struct {
	ID        int64
	Name      string
	UID       string
	Filename  string
	Groups    []DetailGroup
	Addresses []contact.Address
	Lists     []string
	CreatedAt time.Time
	UpdatedAt time.Time
}

// DetailGroup is one labelled block of values in the contact view.
type DetailGroup struct {
	Label  string
	Values []string
}

// ContactIDs extracts the row ids, used to seed the Alpine selection state.
func ContactIDs(d ContactsData) []int64 {
	out := make([]int64, 0, len(d.Contacts))
	for _, c := range d.Contacts {
		out = append(out, c.Contact.ID)
	}
	return out
}

templ ContactDetailPanel(d ContactDetail) {
	<div class="space-y-5">
		<div class="flex items-start justify-between gap-4">
			<div class="min-w-0">
				<h2 class="truncate text-lg font-semibold">{ d.Name }</h2>
				<p class="mt-0.5 truncate text-xs text-muted-foreground">{ d.UID }</p>
			</div>
			<button
				type="button"
				class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-md bg-accent px-3 text-sm text-accent-foreground transition-opacity hover:opacity-90"
				hx-get={ "/dashboard/contacts/" + strconv.FormatInt(d.ID, 10) + "/edit" }
				hx-target="#modal-root"
				hx-swap="innerHTML"
			>
				@Icon("edit")
				<span>Edit</span>
			</button>
		</div>
		if len(d.Lists) > 0 {
			<section class="space-y-1">
				<h3 class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Lists</h3>
				<div class="flex flex-wrap gap-1">
					for _, l := range d.Lists {
						@Chip(l)
					}
				</div>
			</section>
		}
		for _, g := range d.Groups {
			<section class="space-y-1">
				<h3 class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">{ g.Label }</h3>
				<div class="space-y-1">
					for _, v := range g.Values {
						<p class="text-sm">{ v }</p>
					}
				</div>
			</section>
		}
		if len(d.Addresses) > 0 {
			<section class="space-y-1">
				<h3 class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Addresses</h3>
				<div class="space-y-1">
					for _, a := range d.Addresses {
						<p class="text-sm">{ formatAddress(a) }</p>
					}
				</div>
			</section>
		}
		<section class="space-y-1 border-t border-border pt-4 text-xs text-muted-foreground">
			<p>Created { relativeTime(&d.CreatedAt) } · updated { relativeTime(&d.UpdatedAt) }</p>
			<p class="truncate">{ d.Filename }</p>
		</section>
	</div>
}

// BulkListsModal is the shared modal for the two bulk list operations: mode
// "add" unions the chosen lists into each selected contact, "set" replaces their
// lists outright.
templ BulkListsModal(mode string, ids []int64, books []store.Book) {
	<form hx-post="/dashboard/contacts/bulk" hx-target="#contacts-list" hx-swap="outerHTML" class="space-y-4">
		<input type="hidden" name="csrf" value={ uictx.From(ctx).CSRF }/>
		<input type="hidden" name="action" value={ mode }/>
		for _, id := range ids {
			<input type="hidden" name="id" value={ strconv.FormatInt(id, 10) }/>
		}
		@MultiSelect("list", "Lists", bookOptions(books), nil, bulkHint(mode))
		<p class="text-sm text-muted-foreground">{ countLabel(len(ids), "contact") } selected.</p>
		<div class="flex justify-end pt-2">
			@PrimaryButton(bulkSubmitLabel(mode))
		</div>
	</form>
}

func bulkHint(mode string) string {
	if mode == "set" {
		return "Replaces every selected contact's lists with these."
	}
	return "Adds these lists to every selected contact."
}

func bulkSubmitLabel(mode string) string {
	if mode == "set" {
		return "Set lists"
	}
	return "Add to lists"
}

// bulkVals is the hx-vals JSON for a bulk toolbar button.
func bulkVals(action, csrf string) string {
	return `{"action":"` + action + `","csrf":"` + csrf + `"}`
}

func formatAddress(a contact.Address) string {
	parts := make([]string, 0, 3)
	if a.Street != "" {
		parts = append(parts, a.Street)
	}
	if city := strings.TrimSpace(a.City + " " + a.Region + " " + a.Postal); city != "" {
		parts = append(parts, city)
	}
	if a.Country != "" {
		parts = append(parts, a.Country)
	}
	s := strings.Join(parts, ", ")
	if a.Type != "" {
		s = a.Type + ": " + s
	}
	return s
}

templ ContactForm(d ContactFormData) {
	<form
		hx-post={ d.Action }
		hx-target="#contacts-list"
		hx-swap="outerHTML"
		class="space-y-6"
		x-data={ "contactEditor(" + contactEditorData(d) + ")" }
	>
		<input type="hidden" name="csrf" value={ uictx.From(ctx).CSRF }/>
		<section class="relative space-y-3 pb-8">
			<h3 class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Name</h3>
			<div class="grid grid-cols-2 gap-3">
				<div>
					<label class="mb-1 block text-xs font-medium text-muted-foreground" for="n_given">Given name</label>
					<input id="n_given" name="n_given" x-model="name.given" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm outline-none focus:border-transparent focus:ring-2 focus:ring-ring"/>
				</div>
				<div>
					<label class="mb-1 block text-xs font-medium text-muted-foreground" for="n_family">Family name</label>
					<input id="n_family" name="n_family" x-model="name.family" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm outline-none focus:border-transparent focus:ring-2 focus:ring-ring"/>
				</div>
				<div x-show="name.extra.prefix" x-cloak class="space-y-1">
					<div class="flex items-center justify-between">
						<label class="text-xs font-medium text-muted-foreground" for="n_prefix">Prefix</label>
						<button type="button" @click="removeNamePart('prefix')" title="Remove" class="grid h-5 w-5 place-items-center rounded text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
							<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
						</button>
					</div>
					<input id="n_prefix" name="n_prefix" x-model="name.prefix" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm"/>
				</div>
				<div x-show="name.extra.additional" x-cloak class="space-y-1">
					<div class="flex items-center justify-between">
						<label class="text-xs font-medium text-muted-foreground" for="n_additional">Middle name</label>
						<button type="button" @click="removeNamePart('additional')" title="Remove" class="grid h-5 w-5 place-items-center rounded text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
							<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
						</button>
					</div>
					<input id="n_additional" name="n_additional" x-model="name.additional" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm"/>
				</div>
				<div x-show="name.extra.suffix" x-cloak class="space-y-1">
					<div class="flex items-center justify-between">
						<label class="text-xs font-medium text-muted-foreground" for="n_suffix">Suffix</label>
						<button type="button" @click="removeNamePart('suffix')" title="Remove" class="grid h-5 w-5 place-items-center rounded text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
							<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
						</button>
					</div>
					<input id="n_suffix" name="n_suffix" x-model="name.suffix" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm"/>
				</div>
			</div>
			<div class="absolute bottom-2 right-2">
				@PartMenu("'name-menu'", "showNamePart(p.id)", "namePartsAvailable()", "+", "grid h-7 w-7 place-items-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground")
			</div>
		</section>
		<hr class="border-border"/>
		<div class="space-y-5">
			<template x-for="g in groups" :key="g.kind">
				<section class="space-y-3">
					<div class="flex items-center justify-between border-b border-border pb-2">
						<h4 class="text-xs font-semibold uppercase tracking-wide text-muted-foreground" x-text="kindLabel(g.kind)"></h4>
						<template x-if="duplicable(g.kind)">
							<button type="button" @click="addRow(g.kind)" class="inline-flex h-7 items-center rounded-md border border-border px-2 text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">+ Add another</button>
						</template>
						<template x-if="!duplicable(g.kind)">
							<button type="button" @click="removeGroup(g)" title="Remove" class="grid h-7 w-7 place-items-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
								<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
							</button>
						</template>
					</div>
					<div class="space-y-3">
						<template x-for="(row, i) in g.rows" :key="row.uid">
							<div :class="g.kind === 'adr' ? 'relative rounded-md border border-border p-3 pb-9' : (duplicable(g.kind) ? 'relative rounded-md border border-border p-3 pr-10' : '')">
								<template x-if="g.kind === 'adr'">
									<div class="space-y-3">
										<div class="flex items-center justify-between gap-2">
											<input type="hidden" name="adr_type" :value="row.type"/>
											<select
												@change="row.type = $event.target.value"
												class="h-8 rounded-md border border-input bg-background px-2 text-xs"
												:class="row.type === '' ? 'text-muted-foreground' : ''"
											>
												<option value="">type</option>
												<template x-for="t in typesFor('adr')" :key="t">
													<option :value="t" :selected="row.type === t" x-text="t"></option>
												</template>
											</select>
											<button type="button" @click="removeRow(g, i)" title="Remove address" class="grid h-7 w-7 place-items-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
												<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
											</button>
										</div>
										<div class="grid grid-cols-2 gap-3">
											<input name="adr_street" x-model="row.street" placeholder="Street" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm"/>
											<input name="adr_city" x-model="row.city" placeholder="City" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm"/>
											<div x-show="row.extra.pobox" x-cloak class="space-y-1">
												<div class="flex items-center justify-between">
													<span class="text-xs font-medium text-muted-foreground">PO box</span>
													<button type="button" @click="removeAddressPart(i, 'pobox')" title="Remove" class="grid h-5 w-5 place-items-center rounded text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
														<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
													</button>
												</div>
												<input name="adr_pobox" x-model="row.pobox" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm"/>
											</div>
											<div x-show="row.extra.ext" x-cloak class="space-y-1">
												<div class="flex items-center justify-between">
													<span class="text-xs font-medium text-muted-foreground">Unit / ext</span>
													<button type="button" @click="removeAddressPart(i, 'ext')" title="Remove" class="grid h-5 w-5 place-items-center rounded text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
														<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
													</button>
												</div>
												<input name="adr_ext" x-model="row.ext" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm"/>
											</div>
											<div x-show="row.extra.region" x-cloak class="space-y-1">
												<div class="flex items-center justify-between">
													<span class="text-xs font-medium text-muted-foreground">Region</span>
													<button type="button" @click="removeAddressPart(i, 'region')" title="Remove" class="grid h-5 w-5 place-items-center rounded text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
														<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
													</button>
												</div>
												<input name="adr_region" x-model="row.region" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm"/>
											</div>
											<div x-show="row.extra.postal" x-cloak class="space-y-1">
												<div class="flex items-center justify-between">
													<span class="text-xs font-medium text-muted-foreground">Postal code</span>
													<button type="button" @click="removeAddressPart(i, 'postal')" title="Remove" class="grid h-5 w-5 place-items-center rounded text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
														<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
													</button>
												</div>
												<input name="adr_postal" x-model="row.postal" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm"/>
											</div>
											<div x-show="row.extra.country" x-cloak class="space-y-1">
												<div class="flex items-center justify-between">
													<span class="text-xs font-medium text-muted-foreground">Country</span>
													<button type="button" @click="removeAddressPart(i, 'country')" title="Remove" class="grid h-5 w-5 place-items-center rounded text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
														<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
													</button>
												</div>
												<input name="adr_country" x-model="row.country" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm"/>
											</div>
										</div>
										<div class="absolute bottom-2 right-2">
											@PartMenu("'adr-menu-' + i", "showAddressPart(i, p.id)", "addressPartsAvailable(i)", "+", "grid h-7 w-7 place-items-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground")
										</div>
									</div>
								</template>
								<template x-if="g.kind !== 'adr'">
									<div>
										<input type="hidden" name="row_kind" :value="g.kind"/>
										<input type="hidden" name="row_key" :value="row.key"/>
										<input type="hidden" name="row_type" :value="row.type"/>
										<template x-if="duplicable(g.kind)">
											<button type="button" @click="removeRow(g, i)" title="Remove" class="absolute right-2 top-2 grid h-5 w-5 place-items-center rounded text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
												<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
											</button>
										</template>
										<div :class="g.kind === 'custom' ? 'grid grid-cols-2 gap-3' : (hasTypes(g.kind) ? 'grid grid-cols-[9rem_1fr] gap-3' : 'grid grid-cols-1 gap-3')">
											<template x-if="g.kind === 'custom'">
												<input type="text" x-model="row.key" placeholder="X-KEY" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm"/>
											</template>
											<template x-if="g.kind !== 'custom' && hasTypes(g.kind)">
												<select
													@change="row.type = $event.target.value"
													class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm outline-none"
													:class="row.type === '' ? 'text-muted-foreground' : ''"
												>
													<option value="">type</option>
													<template x-for="t in typesFor(g.kind)" :key="t">
														<option :value="t" :selected="row.type === t" x-text="t"></option>
													</template>
												</select>
											</template>
											<input name="row_value" x-model="row.value" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm"/>
										</div>
									</div>
								</template>
							</div>
						</template>
					</div>
				</section>
			</template>
			<div class="flex justify-end">
				@PartMenu("'field-menu'", "addField(p.id)", "availableKinds()", "Add Field", "inline-flex h-9 items-center rounded-md border border-border bg-background px-3 text-sm transition-colors hover:bg-muted")
			</div>
		</div>
		<hr class="border-border"/>
		<section class="space-y-2">
			@MultiSelect("book", "Lists", bookOptions(d.Books), d.Selected, "")
		</section>
		if d.ID != 0 {
			<p class="text-xs text-muted-foreground">{ d.UID } · { d.Filename }</p>
		}
		<div class="flex items-center justify-between gap-2 pt-2">
			<div>
				if d.ID != 0 {
					<button
						type="button"
						class="inline-flex h-9 items-center rounded-md border border-red-600/40 px-3 text-sm text-red-600 transition-colors hover:bg-red-600/10"
						hx-post={ "/dashboard/contacts/" + strconv.FormatInt(d.ID, 10) + "/delete" }
						hx-target="#contacts-list"
						hx-swap="outerHTML"
						hx-confirm="Delete this contact? It is soft-deleted and purged after two days."
					>Delete</button>
				}
			</div>
			@PrimaryButton("Save")
		</div>
	</form>
}
