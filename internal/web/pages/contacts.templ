package pages

import (
	"strconv"

	"github.com/nicolaegr/mnemo/internal/store"
	"github.com/nicolaegr/mnemo/internal/web/uictx"
)

// ContactView is one contact plus the books it is tagged into.
type ContactView struct {
	Contact store.Contact
	Name    string
	Tel     string
	Email   string
	Books   map[int64]bool
}

templ ContactsPage(contacts []ContactView, books []store.Book, q, errMsg string) {
	<div class="space-y-6">
		<div>
			<h1 class="text-2xl font-bold tracking-tight">Contacts</h1>
			<p class="mt-1 text-sm text-muted-foreground">Search and tag the contacts you sync.</p>
		</div>
		<input
			type="search"
			name="q"
			value={ q }
			placeholder="Search by name or phone"
			hx-get="/dashboard/contacts/search"
			hx-target="#contacts-list"
			hx-swap="outerHTML"
			hx-trigger="keyup changed delay:300ms, search"
			class="w-full max-w-sm rounded-md border border-input bg-background px-3 py-2 text-sm"
		/>
		<form
			hx-post="/dashboard/contacts"
			hx-target="#contacts-list"
			hx-swap="outerHTML"
			class="flex flex-wrap items-end gap-3 rounded-lg border border-border bg-background p-4"
		>
			<input type="hidden" name="csrf" value={ uictx.From(ctx).CSRF }/>
			<div class="space-y-1.5">
				<label class="text-xs font-medium text-muted-foreground" for="new-name">Name</label>
				<input id="new-name" name="name" required placeholder="Alice Example" class="rounded-md border border-input bg-background px-3 py-2 text-sm"/>
			</div>
			<div class="space-y-1.5">
				<label class="text-xs font-medium text-muted-foreground" for="new-tel">Phone</label>
				<input id="new-tel" name="tel" placeholder="+1 555 0100" class="rounded-md border border-input bg-background px-3 py-2 text-sm"/>
			</div>
			<div class="space-y-1.5">
				<label class="text-xs font-medium text-muted-foreground" for="new-email">Email</label>
				<input id="new-email" name="email" type="email" class="rounded-md border border-input bg-background px-3 py-2 text-sm"/>
			</div>
			<button type="submit" class="btn btn-secondary bg-accent text-accent-foreground px-3 py-2 text-sm">Add contact</button>
		</form>
		@ContactList(contacts, books, errMsg)
	</div>
}

templ ContactList(contacts []ContactView, books []store.Book, errMsg string) {
	<div id="contacts-list" class="space-y-4">
		if errMsg != "" {
			<p class="rounded-md border border-red-600/40 bg-red-600/10 px-3 py-2 text-sm text-red-600">{ errMsg }</p>
		}
		if len(contacts) == 0 {
			<p class="text-sm text-muted-foreground">No contacts.</p>
		} else {
			for _, c := range contacts {
				@ContactCard(c, books)
			}
		}
	</div>
}

templ ContactCard(c ContactView, books []store.Book) {
	<div class="rounded-lg border border-border bg-background p-4">
		<div class="flex flex-wrap items-baseline gap-2">
			<span class="font-medium">{ c.Name }</span>
			<span class="text-xs text-muted-foreground">{ c.Contact.UID }</span>
			<span class="text-xs text-muted-foreground">{ c.Contact.Filename }</span>
		</div>
		<form
			hx-post={ "/dashboard/contacts/" + strconv.FormatInt(c.Contact.ID, 10) + "/tags" }
			hx-target="#contacts-list"
			hx-swap="outerHTML"
			class="mt-3 flex flex-wrap items-center gap-3"
		>
			<input type="hidden" name="csrf" value={ uictx.From(ctx).CSRF }/>
			<span class="text-xs font-medium text-muted-foreground">Books</span>
			for _, b := range books {
				<label class="flex items-center gap-1.5 text-sm">
					<input type="checkbox" name="book" value={ strconv.FormatInt(b.ID, 10) } checked?={ c.Books[b.ID] }/>
					{ b.DisplayName }
				</label>
			}
			<button type="submit" class="btn btn-secondary px-3 py-1.5 text-xs">Save tags</button>
		</form>
		<details class="mt-3">
			<summary class="cursor-pointer text-xs font-medium text-muted-foreground">Edit fields</summary>
			<form
				hx-post={ "/dashboard/contacts/" + strconv.FormatInt(c.Contact.ID, 10) + "/edit" }
				hx-target="#contacts-list"
				hx-swap="outerHTML"
				class="mt-3 flex flex-wrap items-end gap-3"
			>
				<input type="hidden" name="csrf" value={ uictx.From(ctx).CSRF }/>
				<div class="space-y-1.5">
					<label class="text-xs font-medium text-muted-foreground">Name</label>
					<input name="name" value={ c.Name } class="rounded-md border border-input bg-background px-3 py-2 text-sm"/>
				</div>
				<div class="space-y-1.5">
					<label class="text-xs font-medium text-muted-foreground">Phone</label>
					<input name="tel" value={ c.Tel } class="rounded-md border border-input bg-background px-3 py-2 text-sm"/>
				</div>
				<div class="space-y-1.5">
					<label class="text-xs font-medium text-muted-foreground">Email</label>
					<input name="email" value={ c.Email } class="rounded-md border border-input bg-background px-3 py-2 text-sm"/>
				</div>
				<button type="submit" class="btn btn-secondary px-3 py-2 text-sm">Save</button>
				<button
					type="submit"
					class="btn btn-secondary px-3 py-2 text-sm text-red-600"
					hx-post={ "/dashboard/contacts/" + strconv.FormatInt(c.Contact.ID, 10) + "/delete" }
					hx-confirm="Delete this contact? It is soft-deleted and purged after two days."
				>Delete</button>
			</form>
		</details>
	</div>
}
