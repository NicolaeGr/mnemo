package pages

import (
	"encoding/json"
	"strconv"

	"github.com/nicolaegr/mnemo/internal/store"
	"github.com/nicolaegr/mnemo/internal/web/uictx"
)

// DeviceView is one device plus its explicit per-book opt-outs.
type DeviceView struct {
	Principal store.Principal
	Overrides map[int64]bool
}

// DevicesData is the devices page and its rows fragment.
type DevicesData struct {
	Devices []DeviceView
	Sort    string
	Dir     string
	ErrMsg  string
}

func devicesViewData(d DevicesData) string {
	data, _ := json.Marshal(map[string]any{
		"sort":     d.Sort,
		"dir":      d.Dir,
		"per":      max(len(d.Devices), 1),
		"total":    len(d.Devices),
		"endpoint": "/dashboard/devices/rows",
		"target":   "#devices-rows",
	})
	return string(data)
}

templ DevicesPage(d DevicesData) {
	<div class="space-y-6">
		@PageHeader("Devices", countLabel(len(d.Devices), "device"), addDevice())
		<div id="devices-notice"></div>
		@DeviceList(d)
	</div>
}

// DeviceList is the swap target for device mutations.
templ DeviceList(d DevicesData) {
	<div id="devices-list">
		@DevicesTable(d)
	</div>
}

templ DevicesTable(d DevicesData) {
	<div x-data={ "listView(" + devicesViewData(d) + ")" } @listmeta.window="onMeta($event)">
		<div class="overflow-hidden rounded-lg border border-border">
			<table class="w-full text-sm">
				<thead class="border-b border-border bg-muted/40">
					<tr>
						<th scope="col" class="w-px px-3 py-2"><span class="sr-only">Actions</span></th>
						@SortableTh("label", "Label", "")
						@SortableTh("tier", "Tier", "")
						@SortableTh("last", "Last sync", "")
						<th scope="col" class="hidden px-3 py-2 text-left text-xs font-medium text-muted-foreground sm:table-cell">Hidden lists</th>
					</tr>
				</thead>
				<tbody id="devices-rows" class="divide-y divide-border">
					@DeviceRows(d)
				</tbody>
			</table>
		</div>
	</div>
}

// DeviceRows renders both into the page and as the htmx response for #devices-rows.
templ DeviceRows(d DevicesData) {
	if d.ErrMsg != "" {
		<tr>
			<td colspan="5" class="px-3 py-4">
				@ErrorBanner(d.ErrMsg)
			</td>
		</tr>
	} else if len(d.Devices) == 0 {
		<tr>
			<td colspan="5">
				@EmptyState("No devices yet", "Add a device to get a token, then point your phone or desktop client at your CardDAV URL.", addDevice())
			</td>
		</tr>
	} else {
		for _, dev := range d.Devices {
			@DeviceRow(dev)
		}
	}
}

templ DeviceRow(d DeviceView) {
	<tr class="hover:bg-muted/40">
		<td class="w-px px-3 py-2">
			<button
				type="button"
				class="grid h-8 w-8 place-items-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
				title="Edit device"
				hx-get={ "/dashboard/devices/" + strconv.FormatInt(d.Principal.ID, 10) + "/edit" }
				hx-target="#modal-root"
				hx-swap="innerHTML"
			>@Icon("edit")
</button>
		</td>
		<td class="px-3 py-2 font-medium">{ d.Principal.Label }</td>
		<td class="px-3 py-2">
			if d.Principal.Tier == "primary" {
				@Badge(d.Principal.Tier, "accent")
			} else {
				@Badge(d.Principal.Tier, "muted")
			}
		</td>
		<td class="px-3 py-2 text-muted-foreground">
			<span class="mr-2">{ relativeTime(d.Principal.LastSyncedAt) }</span>
			if isStale(d.Principal.LastSyncedAt) {
				@Badge("stale", "danger")
			}
		</td>
		<td class="hidden px-3 py-2 text-muted-foreground sm:table-cell">{ hiddenCount(d) }</td>
	</tr>
}

templ addDevice() {
	<button
		type="button"
		class="inline-flex h-9 items-center gap-1.5 rounded-md bg-accent px-3 text-sm text-accent-foreground transition-opacity hover:opacity-90"
		hx-get="/dashboard/devices/new"
		hx-target="#modal-root"
		hx-swap="innerHTML"
	>
		@Icon("plus")
		<span>Add device</span>
	</button>
}

// DeviceAddForm is the create form; the response shows the token once in the
// notice area and closes the modal.
templ DeviceAddForm() {
	<form hx-post="/dashboard/devices" hx-target="#devices-list" hx-swap="outerHTML" class="space-y-4">
		<input type="hidden" name="csrf" value={ uictx.From(ctx).CSRF }/>
		@TextField("Label", "label", "", "My phone", true)
		@SelectField("Tier", "tier", "primary", TierOptions())
		<div class="flex justify-end pt-2">
			@PrimaryButton("Add device")
		</div>
	</form>
}

// DeviceForm is the edit form.
templ DeviceForm(d DeviceView, books []store.Book) {
	<form hx-post={ "/dashboard/devices/" + strconv.FormatInt(d.Principal.ID, 10) + "/edit" } hx-target="#devices-list" hx-swap="outerHTML" class="space-y-4">
		<input type="hidden" name="csrf" value={ uictx.From(ctx).CSRF }/>
		@TextField("Label", "label", d.Principal.Label, "", true)
		@SelectField("Tier", "tier", d.Principal.Tier, TierOptions())
		@MultiSelect("hide", "Hidden lists (this device only)", bookOptions(books), hiddenBookIDs(d.Overrides, books), "Lists this device should not sync.")
		<div class="flex items-center justify-between gap-2 pt-2">
			<button
				type="button"
				class="inline-flex h-9 items-center rounded-md border border-red-600/40 px-3 text-sm text-red-600 transition-colors hover:bg-red-600/10"
				hx-post={ "/dashboard/devices/" + strconv.FormatInt(d.Principal.ID, 10) + "/delete" }
				hx-target="#devices-list"
				hx-swap="outerHTML"
				hx-confirm="Revoke this device? Its token stops working immediately."
			>Revoke</button>
			@PrimaryButton("Save")
		</div>
	</form>
}

// TokenNoticeOOB swaps the freshly minted token into the page notice area.
templ TokenNoticeOOB(token string) {
	<div id="devices-notice" hx-swap-oob="innerHTML">
		<div class="rounded-lg border border-border bg-muted p-4">
			<p class="text-sm font-medium">New device token</p>
			<p class="mt-1 text-xs text-muted-foreground">Copy it now; it is shown only once.</p>
			<code class="mt-2 block break-all rounded-md bg-background px-3 py-2 text-sm">{ token }</code>
		</div>
	</div>
}

func hidesBook(overrides map[int64]bool, bookID int64) bool {
	enabled, ok := overrides[bookID]
	return ok && !enabled
}

// hiddenCount is how many of the device's opt-out rows hide a list.
func hiddenCount(d DeviceView) int {
	n := 0
	for _, enabled := range d.Overrides {
		if !enabled {
			n++
		}
	}
	return n
}

func hiddenBookIDs(overrides map[int64]bool, books []store.Book) []int64 {
	out := make([]int64, 0)
	for _, b := range books {
		if hidesBook(overrides, b.ID) {
			out = append(out, b.ID)
		}
	}
	return out
}
