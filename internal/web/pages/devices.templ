package pages

import (
	"strconv"
	"time"

	"github.com/nicolaegr/mnemo/internal/store"
	"github.com/nicolaegr/mnemo/internal/web/uictx"
)

// DeviceView is one device plus its explicit per-book opt-outs.
type DeviceView struct {
	Principal store.Principal
	Overrides map[int64]bool
}

templ DevicesPage(devices []DeviceView, errMsg string) {
	<div class="space-y-6">
		<div class="flex items-center justify-between gap-4">
			<div>
				<h1 class="text-xl font-semibold tracking-tight">Devices</h1>
				<p class="text-xs text-muted-foreground">{ countLabel(len(devices), "device") }</p>
			</div>
			<button
				type="button"
				class="inline-flex h-9 items-center rounded-md bg-accent px-3 text-sm text-accent-foreground transition-opacity hover:opacity-90"
				hx-get="/dashboard/devices/new"
				hx-target="#modal-root"
				hx-swap="innerHTML"
			>Add device</button>
		</div>
		<div id="devices-notice"></div>
		@DeviceList(devices, errMsg)
	</div>
}

templ DeviceList(devices []DeviceView, errMsg string) {
	<div id="devices-list" class="space-y-3">
		if errMsg != "" {
			@ErrorBanner(errMsg)
		}
		if len(devices) == 0 {
			<p class="text-sm text-muted-foreground">No devices yet.</p>
		} else {
			for _, d := range devices {
				@DeviceCard(d)
			}
		}
	</div>
}

templ DeviceCard(d DeviceView) {
	<div class="flex items-center justify-between gap-4 rounded-lg border border-border bg-background px-4 py-3">
		<div class="min-w-0">
			<div class="flex flex-wrap items-center gap-2">
				<span class="font-medium">{ d.Principal.Label }</span>
				<span class="rounded-full bg-muted px-2 py-0.5 text-xs">{ d.Principal.Tier }</span>
			</div>
			<p class="mt-1 text-xs text-muted-foreground">last sync: { lastSeen(d.Principal) }</p>
		</div>
		<button
			type="button"
			class="inline-flex h-8 shrink-0 items-center rounded-md border border-border px-3 text-xs transition-colors hover:bg-muted"
			hx-get={ "/dashboard/devices/" + strconv.FormatInt(d.Principal.ID, 10) + "/edit" }
			hx-target="#modal-root"
			hx-swap="innerHTML"
		>Edit</button>
	</div>
}

// DeviceAddForm is the create form; the response shows the token once in the
// notice area and closes the modal.
templ DeviceAddForm() {
	<form hx-post="/dashboard/devices" hx-target="#devices-list" hx-swap="outerHTML" class="space-y-4">
		<input type="hidden" name="csrf" value={ uictx.From(ctx).CSRF }/>
		@TextField("Label", "label", "", "My phone", true)
		@SelectField("Tier", "tier", "primary", TierOptions())
		<div class="flex justify-end pt-2">
			@PrimaryButton("Add device")
		</div>
	</form>
}

// DeviceForm is the edit form.
templ DeviceForm(d DeviceView, books []store.Book) {
	<form hx-post={ "/dashboard/devices/" + strconv.FormatInt(d.Principal.ID, 10) + "/edit" } hx-target="#devices-list" hx-swap="outerHTML" class="space-y-4">
		<input type="hidden" name="csrf" value={ uictx.From(ctx).CSRF }/>
		@TextField("Label", "label", d.Principal.Label, "", true)
		@SelectField("Tier", "tier", d.Principal.Tier, TierOptions())
		@MultiSelect("hide", "Hidden books (this device only)", bookOptions(books), hiddenBookIDs(d.Overrides, books), "Books this device should not sync.")
		<div class="flex items-center justify-between gap-2 pt-2">
			<button
				type="submit"
				class="inline-flex h-9 items-center rounded-md border border-red-600/40 px-3 text-sm text-red-600 transition-colors hover:bg-red-600/10"
				hx-post={ "/dashboard/devices/" + strconv.FormatInt(d.Principal.ID, 10) + "/delete" }
				hx-target="#devices-list"
				hx-swap="outerHTML"
				hx-confirm="Revoke this device? Its token stops working immediately."
			>Revoke</button>
			@PrimaryButton("Save")
		</div>
	</form>
}

// TokenNoticeOOB swaps the freshly minted token into the page notice area.
templ TokenNoticeOOB(token string) {
	<div id="devices-notice" hx-swap-oob="innerHTML">
		<div class="rounded-lg border border-border bg-muted p-4">
			<p class="text-sm font-medium">New device token</p>
			<p class="mt-1 text-xs text-muted-foreground">Copy it now; it is shown only once.</p>
			<code class="mt-2 block break-all rounded-md bg-background px-3 py-2 text-sm">{ token }</code>
		</div>
	</div>
}

func hidesBook(overrides map[int64]bool, bookID int64) bool {
	enabled, ok := overrides[bookID]
	return ok && !enabled
}

func hiddenBookIDs(overrides map[int64]bool, books []store.Book) []int64 {
	out := make([]int64, 0)
	for _, b := range books {
		if hidesBook(overrides, b.ID) {
			out = append(out, b.ID)
		}
	}
	return out
}

func lastSeen(p store.Principal) string {
	if p.LastSyncedAt == nil {
		return "never"
	}
	return p.LastSyncedAt.Format(time.RFC3339)
}
