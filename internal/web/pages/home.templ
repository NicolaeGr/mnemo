package pages

templ Home() {
	<section class="mx-auto max-w-6xl px-4 py-20 md:py-28">
		<div class="mx-auto max-w-2xl text-center">
			<span class="inline-flex items-center rounded-full border border-border px-3 py-1 text-xs font-medium text-muted-foreground">Template</span>
			<h1 class="mt-6 text-4xl font-bold tracking-tight md:text-6xl">Your project,<br/>ready to build on.</h1>
			<p class="mt-6 text-lg text-muted-foreground">
				A starting point with auth, a Postgres-backed store, Redis sessions
				and caching, and server-rendered layouts.
			</p>
			<div class="mt-10 flex items-center justify-center gap-3">
				<a href="/login" hx-get="/login" hx-push-url="true" class="btn btn-secondary bg-accent text-accent-foreground hover:opacity-90">Open the app</a>
				<a href="/about" hx-get="/about" hx-push-url="true" class="btn btn-outline">Learn more</a>
			</div>
		</div>
	</section>
}
