package pages

templ Login() {
	<div class="rounded-xl border border-border bg-background p-8 shadow-lg">
		<div class="text-center">
			<span class="mx-auto grid h-10 w-10 place-items-center rounded-lg bg-accent text-accent-foreground font-semibold">M</span>
			<h1 class="mt-4 text-xl font-semibold tracking-tight">Sign in</h1>
			<p class="mt-1 text-sm text-muted-foreground">Manage your contacts and devices.</p>
		</div>
		@LoginForm()
	</div>
}

// Register is the first-run form. It is only reachable while no account
// exists.
templ Register() {
	<div class="rounded-xl border border-border bg-background p-8 shadow-lg">
		<div class="text-center">
			<span class="mx-auto grid h-10 w-10 place-items-center rounded-lg bg-accent text-accent-foreground font-semibold">M</span>
			<h1 class="mt-4 text-xl font-semibold tracking-tight">Create your account</h1>
			<p class="mt-1 text-sm text-muted-foreground">This is the first account, so it owns the server.</p>
		</div>
		@RegisterForm()
	</div>
}

// RegisterForm posts via fetch so errors render inline without losing the
// entered fields.
templ RegisterForm() {
	<form
		class="mt-6 space-y-4"
		x-data="{ username: '', name: '', email: '', password: '', error: '', loading: false }"
		@submit.prevent="
			loading = true; error = '';
			fetch('/register', {
				method: 'POST',
				headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
				body: 'username=' + encodeURIComponent(username)
					+ '&name=' + encodeURIComponent(name)
					+ '&email=' + encodeURIComponent(email)
					+ '&password=' + encodeURIComponent(password)
			}).then(async r => {
				if (r.ok) { window.location.href = '/dashboard'; return; }
				error = (await r.text()) || 'Could not create the account';
				loading = false;
			}).catch(() => { error = 'Network error'; loading = false; });
		"
	>
		<div class="space-y-1.5">
			<label for="username" class="text-sm font-medium">Username</label>
			<input
				id="username"
				name="username"
				type="text"
				required
				x-model="username"
				placeholder="you"
				class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring focus:border-transparent"
			/>
		</div>
		<div class="space-y-1.5">
			<label for="name" class="text-sm font-medium">Name</label>
			<input
				id="name"
				name="name"
				type="text"
				required
				x-model="name"
				class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring focus:border-transparent"
			/>
		</div>
		<div class="space-y-1.5">
			<label for="email" class="text-sm font-medium">Email</label>
			<input
				id="email"
				name="email"
				type="email"
				required
				x-model="email"
				placeholder="you@example.com"
				class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring focus:border-transparent"
			/>
		</div>
		<div class="space-y-1.5">
			<label for="password" class="text-sm font-medium">Password</label>
			<input
				id="password"
				name="password"
				type="password"
				required
				minlength="8"
				x-model="password"
				class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring focus:border-transparent"
			/>
			<p class="text-xs text-muted-foreground">At least 8 characters.</p>
		</div>
		<button type="submit" :disabled="loading" class="btn btn-secondary w-full bg-accent text-accent-foreground hover:opacity-90">
			<span x-show="!loading">Create account</span>
			<span x-show="loading" x-cloak>Creating...</span>
		</button>
		<p x-show="error" x-text="error" class="text-sm text-red-600" x-cloak></p>
	</form>
}

// LoginForm posts via fetch so auth errors render inline without a full redraw
// and without losing the entered fields.
templ LoginForm() {
	<form
		class="mt-6 space-y-4"
		x-data="{ username: '', password: '', error: '', loading: false }"
		@submit.prevent="
			loading = true; error = '';
			fetch('/login', {
				method: 'POST',
				headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
				body: 'username=' + encodeURIComponent(username) + '&password=' + encodeURIComponent(password)
			}).then(async r => {
				if (r.ok) { window.location.href = r.headers.get('X-Redirect') || '/dashboard'; return; }
				error = (await r.text()) || 'Invalid username or password';
				loading = false;
			}).catch(() => { error = 'Network error'; loading = false; });
		"
	>
		<div class="space-y-1.5">
			<label for="username" class="text-sm font-medium">Username or email</label>
			<input
				id="username"
				name="username"
				type="text"
				required
				x-model="username"
				placeholder="you or you@example.com"
				class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring focus:border-transparent"
			/>
		</div>
		<div class="space-y-1.5">
			<label for="password" class="text-sm font-medium">Password</label>
			<input
				id="password"
				name="password"
				type="password"
				required
				x-model="password"
				class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring focus:border-transparent"
			/>
		</div>
		<button type="submit" :disabled="loading" class="btn btn-secondary w-full bg-accent text-accent-foreground hover:opacity-90">
			<span x-show="!loading">Sign in</span>
			<span x-show="loading" x-cloak>Signing in...</span>
		</button>
		<p x-show="error" x-text="error" class="text-sm text-red-600" x-cloak></p>
	</form>
}
